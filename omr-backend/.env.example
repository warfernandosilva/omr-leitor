# Copie para .env e preencha
DATABASE_URL=postgresql+psycopg://postgres:SENHA_FORTE@localhost:5432/omr
JWT_SECRET=gere-uma-chave-com-32+-chars-aleatorios-aqui
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
OMR_ENV=development

# Atalho de desenvolvimento: sem token, toda requisição vira um admin anônimo.
# Deixe COMENTADO fora do dev local — em OMR_ENV=production é ignorado de todo modo.
# OMR_DEV_ANONYMOUS=1

# Assistente de correção com IA local (opcional, sem custo).
# Requer o Ollama rodando nesta máquina: https://ollama.com/download
# Depois: ollama pull moondream
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=moondream
# OLLAMA_TIMEOUT=60
